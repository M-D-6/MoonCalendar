<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon (rounded square + calendar frame, without the "M"; Flutter draws the M by hand). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="132dp" android:height="132dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#3B000D" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:width="132dp" android:height="132dp" android:gravity="center">
        <bitmap android:src="@drawable/splash_icon_frame" android:gravity="fill" />
    </item>
</layer-list>
