<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layoutDirection="rtl" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_layout4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Widget4x2">

    <ImageView
        android:id="@+id/widget_layout4x2_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/widget_root_click_ripple_effect"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/widget_content_container"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Physical (left/right) rules only: the launcher's RTL/LTR handling cannot swap the two halves. -->
        <RelativeLayout
            android:id="@+id/widget_clock_date_row_4x2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <FrameLayout
                android:id="@+id/clock_row_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_alignTop="@+id/textPlaceholder1_4x2"
                android:layout_alignBottom="@+id/textPlaceholder1_4x2"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/widget_divider" />

            <!-- RIGHT half: the clock -->
            <LinearLayout
                android:id="@+id/widget_clock_side_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_toRightOf="@id/clock_row_divider"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/time_header_4x2"
                    style="@style/WidgetTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:fontFamily="sans-serif"
                    android:gravity="center_horizontal" />

                <TextView
                    android:id="@+id/textPlaceholder0_4x2"
                    style="@style/WidgetTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1" />

                <!-- Launcher-driven seconds: a Chronometer is ticked by the launcher itself every second
                     (same mechanism as stopwatch widgets), no alarms involved. -->
                <Chronometer
                    android:id="@+id/clock_chrono_4x2"
                    style="@style/WidgetTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textDirection="ltr"
                    android:visibility="gone" />

                <!-- Minute mode: system TextClock (ticked by the launcher at every minute change; always Latin digits). -->
                <TextClock
                    android:id="@+id/clock_text_4x2"
                    style="@style/WidgetTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textDirection="ltr"
                    android:visibility="gone"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm" />

            </LinearLayout>

            <!-- LEFT half: weekday + dates -->
            <TextView
                android:id="@+id/textPlaceholder1_4x2"
                style="@style/WidgetTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@id/clock_row_divider"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:minLines="4"
                android:text="" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/refresh_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/widget4x2_times_layout" />

            <include layout="@layout/widget4x2_events" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
