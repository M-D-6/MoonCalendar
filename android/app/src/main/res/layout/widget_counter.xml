<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layoutDirection="rtl" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/counter_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/target_container"
            android:layout_width="160dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/target_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="کادر هدف"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/target_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/counter_device"
            android:layout_width="200dp"
            android:layout_height="263dp"
            android:layout_marginTop="0dp">

            <FrameLayout
                android:id="@+id/counter_device_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/screen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="نمایشگر شمارنده"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tally_counter_screen" />

                <ImageView
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="شمارنده"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tally_counter_body" />

                <ImageView
                    android:id="@+id/count"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="عدد شمارنده"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/increment_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="افزایش"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tally_counter_main_button" />

                <ImageView
                    android:id="@+id/decrement_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="کاهش"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tally_counter_reset_button" />

                <TextView
                    android:id="@+id/decrement_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="-1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/reset_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="بازنشانی"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tally_counter_reset_button" />

                <TextView
                    android:id="@+id/reset_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="RESET"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
